{
  "name": "fire-mission-plotter",
  "productName": "Mortar Distance Calculator",
  "version": "1.0.0",
  "description": "Distance and bearing calculator for the L81 Mortar in Wardogs.",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win zip --x64"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.tehhn.firemissionplotter",
    "productName": "Mortar Distance Calculator",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "app/**/*"
    ],
    "win": {
      "target": [
        { "target": "zip", "arch": ["x64"] }
      ],
      "icon": "build/icon.ico"
    }
  }
}
